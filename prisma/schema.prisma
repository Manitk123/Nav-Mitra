generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Challenge {
  id           String   @id @default(cuid())
  title        String
  department   String
  category     String
  budget       Int
  description  String
  status       String   @default("Active")
  createdAt    DateTime @default(now())
  applications Application[]
}

model Application {
  id             String   @id @default(cuid())
  challengeId    String
  startupName    String
  dpiitNumber    String
  solutionDetails String
  estimatedCost  Int
  estimatedTime  Int
  pitchDeckUrl   String?
  aiScore        Int?
  aiSummary      String?
  createdAt      DateTime @default(now())

  challenge      Challenge @relation(fields: [challengeId], references: [id])
  pilot          Pilot?
}

model Pilot {
  id             String   @id @default(cuid())
  applicationId  String   @unique
  challengeId    String
  status         String   @default("Structuring") // Structuring, Active, Completed
  totalBudget    Int
  createdAt      DateTime @default(now())

  application    Application @relation(fields: [applicationId], references: [id])
  milestones     Milestone[]
}

model Milestone {
  id             String   @id @default(cuid())
  pilotId        String
  title          String
  description    String
  allocatedBudget Int
  durationDays   Int
  status         String   @default("Pending") // Pending, In Progress, Completed
  orderIndex     Int
  createdAt      DateTime @default(now())

  pilot          Pilot @relation(fields: [pilotId], references: [id])
}
